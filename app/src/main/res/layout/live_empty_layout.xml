<?xml version="1.0" encoding="utf-8"?>
<!--
    直播页空状态：订阅里没有可用直播频道时显示。
    比原来的弹窗好在不打断操作，页面内直接给「切换直播源」入口。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/icon_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="暂无直播频道"
            android:textColor="@color/text_foreground"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:text="当前订阅没有提供可用的直播源，可以切换已有直播源，或到 设置 → 直播源 里添加。"
            android:textColor="@color/text_sub_foreground"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_switch_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_large_round_gray"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingTop="10dp"
            android:paddingEnd="28dp"
            android:paddingBottom="10dp"
            android:text="切换直播源"
            android:textColor="@color/text_foreground"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
