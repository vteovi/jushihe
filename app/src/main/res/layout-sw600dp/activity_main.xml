<?xml version="1.0" encoding="utf-8"?>
<!-- 平板/大屏布局：左侧竖直导航栏（NavigationRail）+ 右侧内容区，替代竖屏的底部导航。
     id 用 nav_rail 而非 bottom_nav，避免 ViewBinding 在 layout / layout-sw600dp
     两个变体之间对同一 id 推断出不同类型而编译失败 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".ui.activity.MainActivity">

    <!-- 整条 rail 铺满屏幕高度（含状态栏区域）：以前用 marginTop 把 rail 下移，
         会在 rail 的上边缘留下一条阴影/分界线。现在改成背景一直顶到屏幕顶端，
         只用 paddingTop 把菜单图标和文字挤到状态栏下方（真实高度在 MainActivity 里按
         WindowInsets 的 statusBars inset 再算一次，这里 32dp 只是兜底值）。 -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/nav_rail"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:paddingTop="32dp"
        app:itemIconSize="26dp"
        app:itemIconTint="@drawable/bottom_navigation_item_selector"
        app:itemTextColor="@drawable/bottom_navigation_item_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_bottom_navigation" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
