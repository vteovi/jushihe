<?xml version="1.0" encoding="utf-8"?>
<!--
    平板/大屏（sw600dp）详情页布局。
    顶部为「左播放器 + 右影视信息」横向排布，下方整宽区域放线路/选集。
    注意：所有 id 必须与 layout/activity_detail.xml 保持一致且控件类型相同，
    否则 ViewBinding 的字段类型（以默认布局为准）会与 sw600dp 实际控件不匹配导致 ClassCastException。
    播放器占位区(previewPlayerPlace)的宽度由 weight 决定，高度由 DetailActivity.applyTabletPreviewSize()
    按 16:9 计算后写回，播放器浮层(previewPlayer)再由 layoutPreviewOverPlace() 贴到占位上。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ================= 顶部：左播放器 + 右侧信息/按钮 ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_24"
            android:paddingTop="16dp"
            android:paddingRight="@dimen/dp_24">

            <!-- 播放器占位：高度由代码按 16:9 覆盖 -->
            <LinearLayout
                android:id="@+id/previewPlayerPlace"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:layout_weight="1.15"
                android:gravity="center"
                android:orientation="vertical" />

            <!-- 右侧：片名 / 数据源 / 操作按钮，高度由代码与播放器对齐 -->
            <LinearLayout
                android:id="@+id/ll_info_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_20"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="鬼灭之刃鬼灭之刃鬼灭之刃"
                        android:textColor="@color/text_foreground"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_gravity="bottom"
                        android:text="详情 >>"
                        android:textSize="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_large_round_gray"
                        android:drawableRight="@drawable/ic_change_20"
                        android:drawablePadding="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:singleLine="true"
                        android:textColor="@color/text_foreground"
                        tools:text="非凡影视" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/iv_private_browsing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="10dp"
                        android:src="@drawable/ic_private_browsing"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/actionBtnBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ext_fullscreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="全屏"
                        android:padding="6dp"
                        android:src="@drawable/ic_fullscreen"
                        app:tint="@color/text_foreground" />

                    <ImageView
                        android:id="@+id/tvExternalPlay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="外部播放"
                        android:padding="6dp"
                        android:src="@drawable/ic_external_play"
                        app:tint="@color/text_foreground" />

                    <ImageView
                        android:id="@+id/tvCast"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="投屏"
                        android:padding="6dp"
                        android:src="@drawable/ic_cast_18"
                        app:tint="@color/text_foreground" />

                    <ImageView
                        android:id="@+id/tvCollect"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="收藏"
                        android:padding="6dp"
                        android:src="@drawable/ic_colloct_18"
                        app:tint="@color/text_foreground" />

                    <ImageView
                        android:id="@+id/tvDownload"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="下载"
                        android:padding="6dp"
                        android:src="@drawable/ic_download_18"
                        app:tint="@color/text_foreground" />

                    <ImageView
                        android:id="@+id/ext_pip"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="画中画"
                        android:padding="6dp"
                        android:src="@drawable/ic_pip"
                        app:tint="@color/text_foreground" />

                    <ImageView
                        android:id="@+id/ext_setting"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="设置"
                        android:padding="6dp"
                        android:src="@drawable/ic_player_setting"
                        app:tint="@color/text_foreground" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/bg_gray" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= 下部：解析 / 线路 / 选集 ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dp_24"
                android:paddingTop="@dimen/dp_8"
                android:paddingRight="@dimen/dp_24"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/mEmptyPlaylist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/dp_24"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/dp_128"
                        android:layout_height="@dimen/dp_128"
                        android:layout_gravity="center"
                        android:src="@drawable/icon_empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_marginLeft="@dimen/dp_10"
                        android:gravity="center"
                        android:text="暂无播放数据" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/parse_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="14dp"
                        android:layout_marginTop="8dp"
                        android:text="解析"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_parse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginVertical="4dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_select_flag" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="线路"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvChangeLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:drawableRight="@drawable/ic_change_20"
                        android:drawablePadding="4dp"
                        android:paddingLeft="20dp"
                        android:paddingVertical="6dp"
                        android:text="快捷换线"
                        android:textColor="@color/text_foreground" />
                </RelativeLayout>

                <!--        线路列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridViewFlag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="4dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_select_flag" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="选集"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tvSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/ic_sort_18"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        android:text="倒序"
                        android:textColor="@color/text_foreground" />

                    <View
                        android:id="@+id/line10"
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@color/gray_darker" />
                    <TextView
                        android:id="@+id/tv_all_series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableRight="@drawable/ic_expand_all_18"
                        android:drawablePadding="4dp"
                        android:paddingVertical="6dp"
                        android:text="全部"
                        android:textColor="@color/text_foreground" />
                </LinearLayout>

                <!--        集数列表-->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mGridView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/dp_10"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/dp_10"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_series"
                    tools:orientation="horizontal" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- 播放器浮层：非全屏时由代码定位到 previewPlayerPlace 上 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

</FrameLayout>
